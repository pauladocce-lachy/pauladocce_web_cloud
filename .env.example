# Copy to .env in the project root; never commit or publish this file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set a strong, unique password (at least 16 characters). Do not reuse a website password.
ADMIN_EMAIL=admin@pauladocce.cz
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Set true only when HTTPS terminates at a trusted reverse proxy.
COOKIE_SECURE=false
